# Copy to .env and change the values. .env is never committed.

# SQLite file (relative to the prisma/ folder)
DATABASE_URL="file:./dev.db"

# Admin account created by `npm run db:seed`
ADMIN_EMAIL="admin@academy.example"
ADMIN_PASSWORD="ChangeMe-Admin-2026"

# Password given to the demo students created by the seed
DEMO_STUDENT_PASSWORD="Student-Demo-2026"

# Public site URL (used for canonical links, sitemap and certificate verification)
NEXT_PUBLIC_SITE_URL="http://localhost:3105"

# Set to "true" when the site is served over HTTPS so the session cookie is Secure
COOKIE_SECURE="false"

# Payment instructions shown to students for paid courses (manual bank transfer)
NEXT_PUBLIC_PAYMENT_NOTE="حوّل المبلغ إلى الحساب البنكي للأكاديمية ثم أرسل رقم الحوالة هنا، وسيُفعَّل تسجيلك بعد التحقق."
